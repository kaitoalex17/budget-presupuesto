# Base de datos (SQLite persistente por defecto, o PostgreSQL para producción mayor)
DATABASE_URL="file:./data/budget.db"

# Clave secreta para sesiones JWT (cambiar en producción)
JWT_SECRET="budget-secret-key-change-this-in-production-2026-saas"

# URL pública de la aplicación (para enlaces de WhatsApp y firma de clientes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: Clave API para asistente IA generador de presupuestos (OpenAI o compatible)
OPENAI_API_KEY=""

# Puerto de la aplicación
PORT=3000
